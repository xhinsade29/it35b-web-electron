# Supabase Configuration
# Copy this file to .env and fill in your actual Supabase credentials
# Get these from your Supabase Dashboard → Project Settings → API

# Supabase Project URL (format: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon/Publishable Key (public key for client-side)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (server-side only - keep secret!)
# This is only needed for admin operations that bypass RLS
# VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
